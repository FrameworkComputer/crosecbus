;
;Module Name:
;    crosecbus.inf
;
;Abstract:
;    INF file for installing the CR50 I2C Driver
;
;
;--*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = Framework Computer
DriverVer   = 10/24/2024,0.0.8.0
CatalogFile = crosecbus.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
crosecbus.sys  = 1,,

;*****************************************
; CrosEcBus  Install Section
;*****************************************

[Manufacturer]
%StdMfg%=Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%CrosEcBus.DeviceDesc%=CrosEcBus_Device, ACPI\FRMWC004

[CrosEcBus_Device.NT]
CopyFiles=Drivers_Dir

[CrosEcBus_Device.NT.HW]
AddReg=CrosEcBus_AddReg

[Drivers_Dir]
crosecbus.sys

[CrosEcBus_AddReg]
; Set to 1 to connect the first interrupt resource found, 0 to leave disconnected
HKR,Settings,"ConnectInterrupt",0x00010001,0
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;UD)"  ;System, Admin, and UMDF drivers

;-------------- Service installation
[CrosEcBus_Device.NT.Services]
AddService = CrosEcBus,%SPSVCINST_ASSOCSERVICE%, CrosEcBus_Service_Inst

; -------------- WDF install section
[CrosEcBus_Device.NT.Wdf]
KmdfService = CrosEcBus, CrosEcBus_wdfsect

[CrosEcBus_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

; -------------- CrosEcBus driver install sections
[CrosEcBus_Service_Inst]
DisplayName    = %CrosEcBus.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\crosecbus.sys
LoadOrderGroup = Base

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
StdMfg                 = "Framework"
DiskId1                = "Chrome EC Installation Disk #1"
CrosEcBus.DeviceDesc = "Framework EC"
CrosEcBus.SVCDESC    = "Chrome EC Service"
